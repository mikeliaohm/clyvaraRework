# Copy this file to .env and fill in your actual values

# OpenAI API Key (required for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL Database Configuration
# For local development with PostgreSQL:
# 1. Install PostgreSQL: brew install postgresql (macOS) or apt-get install postgresql (Linux)
# 2. Start PostgreSQL service
# 3. Create database: createdb clyvara_dev
# 4. Update DATABASE_URL below with your credentials
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/clyvara_dev

# JWT Secret for Authentication (generate a random secret key)
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_random_jwt_secret_here
AUTH_MODE=local
# Comma-separated emails that should receive the admin role on signup/login
LOCAL_ADMIN_EMAILS=admin1@example.com

# AWS S3 Configuration (Optional - for file storage)
# Leave empty to use local file storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=clyvara-uploads

# Admin API Key (Optional - for securing system material uploads)
# Generate a random secret key. If not set, upload endpoint will be open (not recommended for production)
ADMIN_API_KEY=your_random_secret_key_here
